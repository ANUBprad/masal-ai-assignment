# Server-side Gemini credentials. Set the real values in your host's
# environment settings (e.g. Vercel Project Settings) and in a local
# .env.local for development. Never commit real values.

GEMINI_API_KEY=

# Optional. Must be one of the SUPPORTED_MODELS ids in lib/ai.ts.
# Defaults to gemini-2.5-flash when unset or unsupported.
GEMINI_MODEL=
