# Server-side AI provider credentials. Set the real values in your host's
# environment settings (e.g. Vercel Project Settings) and in a local
# .env.local for development. Never commit real values.

# Primary provider. "groq" (default) or "gemini".
AI_PROVIDER=groq

# --- Groq (primary by default) -------------------------------------------
# Create keys at https://console.groq.com/keys
GROQ_API_KEY=

# Optional extra Groq keys. When several are set the app rotates the starting
# key per request and fails over to the next one on a 429/5xx. Numbered keys
# are read up to _5; blanks are ignored.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Optional. Must be a supported Groq model id (openai/gpt-oss-120b or
# openai/gpt-oss-20b). Defaults to openai/gpt-oss-120b when unset/unsupported.
GROQ_MODEL=

# --- Gemini (optional secondary / alternate primary) ---------------------
# If set, Gemini is used as a failover target; set AI_PROVIDER=gemini to make
# it primary. Leave blank to run Groq-only.
GEMINI_API_KEY=
# Optional. Must be a supported Gemini model id (gemini-flash-lite-latest,
# gemini-3.5-flash-lite, or gemini-3.1-flash-lite). The retired gemini-2.5-*
# ids now return 404. Defaults to gemini-flash-lite-latest when unset.
GEMINI_MODEL=
